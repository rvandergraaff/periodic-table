% ============================================
% 2. COMANDO MEJORADO \celda
% ============================================
\newcommand{\celda}[6]{
  % Posición de la celda
  \coordinate (pos) at ([xshift=#1*\ancho cm, yshift=-#2*\alto cm] G);
  
  % Dibujar celda coloreada con borde
  \fill[#6] (pos) rectangle ++(\ancho cm, -\alto cm);
  \draw[black, thin] (pos) rectangle ++(\ancho cm, -\alto cm);
  
  % Centro de la celda
  \coordinate (centro) at ([xshift=0.5*\ancho cm, yshift=-0.5*\alto cm] pos);
  
  % Número atómico (arriba izquierda)

\node[anchor=north west, inner sep=0.5pt, font=\normalsize\bfseries] 
  at ([xshift=0.08cm, yshift=-0.2cm] pos) {#3};  % Más margen
    
  % Símbolo (centrado, grande)
  \node[font=\Large\sffamily\bfseries] at (centro) {#4};
  
  % Nombre (abajo centrado) - ¡VERSIÓN CORREGIDA!
  \node[anchor=center, font=\tiny\bfseries, text=black, yshift=-0.7cm] 
  at (centro) {#5};
}
